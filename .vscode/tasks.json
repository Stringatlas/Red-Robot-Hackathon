{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arduino: Configure IntelliSense",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/scripts/configure_vscode.py"],
      "problemMatcher": []
    },
    {
      "label": "Arduino: Build ESP32-S3",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--fqbn", "esp32:esp32:esp32s3",
        "--build-path", "${workspaceFolder}/.vscode/build",
        "${workspaceFolder}"
      ],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    }
  ]
}

